    The only colours in this app that are not from the theme. They are fixed,
    as the diagnostic readout's are, because they are drawn over a remote
    desktop of unknown brightness rather than over one of the app's surfaces;
    a panel that followed the light theme could be unreadable there.
-->
<resources>
    <color name="session_panel">#cc101418</color>
    <color name="session_ink">#ffe8f0ff</color>

    <!-- The desktop preview's stand-in before the first screenshot exists, and
         the scrim under the text on a card. Fixed for the same reason: both
         sit behind white text over something of unknown brightness. -->
    <color name="preview_placeholder_start">#ff071842</color>
    <color name="preview_placeholder_end">#ff2563eb</color>
    <color name="preview_scrim_end">#cc000000</color>
</resources>
