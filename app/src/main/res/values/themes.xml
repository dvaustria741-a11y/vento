    A fixed palette in the style of the Windows App (values/palette.xml and
    values-night/palette.xml), not Material You. The dynamic palette is applied
    per activity as a theme overlay and would replace every colour role set
    here, so RemoteDesktopApp no longer applies it.
-->
<resources>

    <style name="Theme.RemoteDesktop" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- The header and the bottom bar draw under the system bars, so the
             bars are transparent. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>

        <item name="colorPrimary">@color/palette_primary</item>
        <item name="colorOnPrimary">@color/palette_on_primary</item>
        <item name="colorPrimaryContainer">@color/palette_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/palette_on_primary_container</item>
        <item name="colorSecondary">@color/palette_primary</item>
        <item name="colorOnSecondary">@color/palette_on_primary</item>
        <item name="colorSecondaryContainer">@color/palette_container_highest</item>
        <item name="colorOnSecondaryContainer">@color/palette_on_surface</item>
        <item name="colorTertiary">@color/palette_primary</item>
        <item name="colorOnTertiary">@color/palette_on_primary</item>
        <item name="colorTertiaryContainer">@color/palette_primary_container</item>
        <item name="colorOnTertiaryContainer">@color/palette_on_primary_container</item>
        <item name="colorError">@color/palette_error</item>
        <item name="colorOnError">@color/palette_on_error</item>

        <item name="android:colorBackground">@color/palette_surface</item>
        <item name="colorOnBackground">@color/palette_on_surface</item>
        <item name="colorSurface">@color/palette_surface</item>
        <item name="colorOnSurface">@color/palette_on_surface</item>
        <item name="colorSurfaceVariant">@color/palette_container_highest</item>
        <item name="colorOnSurfaceVariant">@color/palette_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/palette_on_surface</item>
        <item name="colorOnSurfaceInverse">@color/palette_surface</item>
        <item name="colorSurfaceTint">@android:color/transparent</item>
        <item name="colorOutline">@color/palette_outline</item>
        <item name="colorOutlineVariant">@color/palette_outline_variant</item>

        <!-- The page is one flat colour, and only things that sit on it (a
             dialog, a field, a thumbnail) are a step lighter. -->
        <item name="colorSurfaceDim">@color/palette_surface</item>
        <item name="colorSurfaceBright">@color/palette_container_high</item>
        <item name="colorSurfaceContainerLowest">@color/palette_surface</item>
        <item name="colorSurfaceContainerLow">@color/palette_surface</item>
        <item name="colorSurfaceContainer">@color/palette_surface</item>
        <item name="colorSurfaceContainerHigh">@color/palette_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/palette_container_highest</item>

        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.RemoteDesktop</item>
        <item name="materialSwitchStyle">@style/Widget.RemoteDesktop.Switch</item>
        <item name="bottomNavigationStyle">@style/Widget.RemoteDesktop.BottomNav</item>
    </style>

    <!--
        The settings tree, drawn as groups of rows.

        androidx.preference has one row background and a divider between
        categories, and no way to style a run of rows as a group. The system
        Settings app gets this from SettingsLib, which is internal to AOSP, so
        it is reproduced here: custom layouts, and an adapter in
        SettingsActivity that picks each row's background from its position in
        its group.
    -->
    <style name="PreferenceThemeOverlay.RemoteDesktop" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/Widget.RemoteDesktop.Preference</item>
        <item name="preferenceScreenStyle">@style/Widget.RemoteDesktop.Preference</item>
        <item name="dialogPreferenceStyle">@style/Widget.RemoteDesktop.Preference.Dialog</item>
        <item name="editTextPreferenceStyle">@style/Widget.RemoteDesktop.Preference.EditText</item>
        <item name="switchPreferenceCompatStyle">@style/Widget.RemoteDesktop.Preference.Switch</item>
        <item name="preferenceCategoryStyle">@style/Widget.RemoteDesktop.Preference.Category</item>
    </style>

    <!-- One layout for every kind of row, and no dividers: groups are
         separated by their rounded ends, and a divider would cut through one. -->
    <style name="Widget.RemoteDesktop.Preference" parent="Preference.Material">
        <item name="android:layout">@layout/preference_row</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
        <item name="singleLineTitle">false</item>
    </style>

    <!-- Each type's parent sets up the dialog it opens, so these inherit from
         the type-specific parents rather than restating them. -->
    <style name="Widget.RemoteDesktop.Preference.Dialog" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/preference_row</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
        <item name="singleLineTitle">false</item>
    </style>

    <style name="Widget.RemoteDesktop.Preference.EditText"
        parent="Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/preference_row</item>
        <item name="android:dialogLayout">@layout/dialog_option_text</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
        <item name="singleLineTitle">false</item>
    </style>

    <style name="Widget.RemoteDesktop.Preference.Switch"
        parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/preference_row</item>
        <item name="android:widgetLayout">@layout/preference_row_switch</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
        <item name="singleLineTitle">false</item>
    </style>

    <style name="Widget.RemoteDesktop.Preference.Category" parent="Preference.Category.Material">
        <item name="android:layout">@layout/preference_heading</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <!--
        A session shows only the remote desktop: no action bar, no system bars,
        and a black background so the letterboxing around a desktop that does
        not match the phone's aspect ratio is not grey.
    -->
    <style name="Theme.RemoteDesktop.Session" parent="Theme.RemoteDesktop">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
        A dialog on one surface rather than two.

        Material 3's alert dialog paints its window with colorSurfaceContainerHigh,
        but the title block uses the plain floating-window background, so the
        dialog has two tones with a hard edge under the title, visible on any
        dark theme and obvious over a remote desktop. Setting both to the same
        container colour fixes it.
    -->
    <style name="ThemeOverlay.RemoteDesktop.Dialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:colorBackgroundFloating">?attr/colorSurfaceContainerHigh</item>
        <item name="android:colorBackground">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!--
        The connection editor's window, the only full-screen dialog: it is a
        form used with the soft keyboard open, and a sheet holding a keyboard,
        a heading and a footer leaves no room for the form.

        `windowIsFloating` false makes the dialog fill the window; without it
        the rest of this is ignored and the layout's match_parent means the
        height of its own content.

        The palette comes from the parent, Theme.RemoteDesktop, because a dialog
        does not inherit the activity's theme and starts from its own resource.
        The parent used to be the dynamic-colour theme, which kept the dialog in
        step with the activity palette; both are fixed now.
    -->
    <style name="Theme.RemoteDesktop.EditorDialog"
        parent="Theme.RemoteDesktop">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <!--
            A window with `windowIsFloating` false gets no animation of its own,
            and a form that appears instantly looks like a glitch. This uses the
            bottom sheet's slide, since the editor replaced a bottom sheet and
            still comes from the bottom.
        -->
        <item name="android:windowAnimationStyle">@style/Animation.Design.BottomSheetDialog</item>
    </style>

    <!--
        A header's icon button (back, close), matching the system's: a 40 dp
        filled circle centred in a 48 dp touch target. The insets make the
        drawn circle smaller than the target, which is why this is a button
        style rather than a background drawable behind an image.

        Neutral rather than the filled icon button's primary colour: it leaves
        a screen, and the accent colour on these screens means something is
        live.
    -->
    <style name="Widget.RemoteDesktop.HeaderButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">?attr/colorSurfaceContainerHighest</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
        <item name="iconSize">24dp</item>
        <item name="android:insetLeft">4dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetRight">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <!-- Beside the text rather than at the button's leading edge: with no
             text, textStart centres the icon in the circle, while the default
             draws it as a compound drawable against the start padding. -->
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <!-- The thumbnail on a home row has its own rounded corners: it sits inside
         a container with much larger ones and would otherwise be the only
         square-cornered thing on screen. -->
    <style name="ShapeAppearance.RemoteDesktop.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!--
        The editor's two scroll boundaries, the only place a hairline is still
        used. It marks where the scrolling form ends and the fixed heading
        above and footer below begin, which a gap cannot show.
    -->
    <style name="Widget.RemoteDesktop.PanelDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>


    <!-- A value box on a flat row: the choice rows' button. Squarer than a
         tonal button, with the fields' fill, like the Windows App's dropdowns. -->
    <style name="ShapeAppearance.RemoteDesktop.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="Widget.RemoteDesktop.Button.Dropdown"
        parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="backgroundTint">?attr/colorSurfaceContainerHighest</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RemoteDesktop.Field</item>
    </style>

    <!-- A text field as a filled grey box with no outline and no underline at
         rest; the accent shows as an underline while it has focus. -->
    <style name="Widget.RemoteDesktop.TextInputLayout"
        parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHighest</item>
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- Blue thumb on a dark-blue track when on, a light thumb on a grey track
         when off, and no outline either way. -->
    <style name="Widget.RemoteDesktop.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>

    <!-- The bottom bar: flat on the page, with no pill behind the selected
         item; the accent colour on the icon and label is the only marker. -->
    <style name="Widget.RemoteDesktop.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.RemoteDesktop.NavIndicator</item>
    </style>

    <style name="Widget.RemoteDesktop.NavIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- A bare icon in a header (close, add, reorder, view mode). -->
    <style name="Widget.RemoteDesktop.HeaderIcon" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">?attr/colorOnSurface</item>
    </style>

</resources>
