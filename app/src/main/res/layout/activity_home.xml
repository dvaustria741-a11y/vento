<!--
    The connection list in the style of the Windows App: a header with the
    round settings button, the title and the add button; the view-mode button
    and a collapsible section title under it; the list; and the bottom bar.

    A column rather than a list scrolling behind a bar: the header and the bar
    are fixed and the list takes the space between them, so nothing is padded
    around either. HomeActivity applies the system bar insets to the root.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/home_inset"
        android:paddingTop="12dp"
        android:paddingEnd="4dp">

        <!-- Settings, as the Windows App's round account button is. -->
        <ImageButton
            android:id="@+id/avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar"
            android:contentDescription="@string/home_settings"
            android:padding="10dp"
            android:src="@drawable/ic_person"
            app:tint="?attr/colorOnPrimary" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/home_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <!-- Shown only with two or more pinned connections: HomeActivity. -->
        <ImageButton
            android:id="@+id/reorder"
            style="@style/Widget.RemoteDesktop.HeaderIcon"
            android:contentDescription="@string/home_reorder"
            android:src="@drawable/ic_low_priority"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/add"
            style="@style/Widget.RemoteDesktop.HeaderIcon"
            android:contentDescription="@string/home_add"
            android:src="@drawable/ic_add" />

    </LinearLayout>

    <!-- Icon and description show the mode it switches to: HomeActivity. -->
    <ImageButton
        android:id="@+id/view_mode"
        style="@style/Widget.RemoteDesktop.HeaderIcon"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_view_list" />

    <LinearLayout
        android:id="@+id/section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/home_section_toggle"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/home_inset"
        android:paddingEnd="@dimen/home_inset">

        <TextView
            android:id="@+id/section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_section_devices"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/section_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_dropdown"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!--
            No connections to show: none saved, or none pinned on the Favorites
            tab. The texts are set from HomeActivity, since they differ.
        -->
        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_desktop"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/home_empty_title"
                android:textAppearance="?attr/textAppearanceTitleLarge" />

            <TextView
                android:id="@+id/empty_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/home_empty"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- The playground needs no machine, so it is offered here too. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/playground"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/home_empty_playground" />

        </LinearLayout>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/home_nav" />

</LinearLayout>
